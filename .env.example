# Copy to .env and fill in. Never commit the real .env.

# Timezone for the container and for timed events in the ICS feed, e.g. Europe/London
TZ=UTC

# Mealie instance and a long-lived API token (Mealie: Settings -> API Tokens)
MEALIE_BASE_URL=https://mealie.example.com
MEALIE_API_TOKEN=changeme

# Bearer token required to call /api/mcp
MCP_API_TOKEN=changeme

# HMAC key for signing the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=changeme

# Single shared password checked by /login
HUB_PASSWORD=changeme

# Required as ?token=... on /api/calendar.ics. Anyone with the full URL can read the feed.
CALENDAR_FEED_TOKEN=changeme
